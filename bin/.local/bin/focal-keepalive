#!/usr/bin/env python3
"""Keep Focal monitors awake with a quiet ultrasonic Focusrite-only pulse."""

import argparse
from array import array
import math
import subprocess
import sys


RATE = 44_100
FADE_SECONDS = 0.2
DEFAULT_DURATION = 2.0
DEFAULT_FREQUENCY = 20_000.0
DEFAULT_VOLUME = 0.9  # Approximately -1 dBFS before downstream attenuation.


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Play a tone through every connected Focusrite/Scarlett output.",
    )
    parser.add_argument(
        "-f",
        "--frequency",
        type=float,
        default=DEFAULT_FREQUENCY,
        help=f"tone frequency in Hz (default: {DEFAULT_FREQUENCY:g})",
    )
    parser.add_argument(
        "-v",
        "--volume",
        type=float,
        default=DEFAULT_VOLUME,
        help=f"linear PipeWire volume from 0.0 to 1.0 (default: {DEFAULT_VOLUME:g})",
    )
    parser.add_argument(
        "-d",
        "--duration",
        type=float,
        default=DEFAULT_DURATION,
        help=f"duration in seconds (default: {DEFAULT_DURATION:g})",
    )
    args = parser.parse_args()

    if not math.isfinite(args.frequency) or not 0 < args.frequency < RATE / 2:
        parser.error(f"frequency must be above 0 and below {RATE / 2:g} Hz")
    if not math.isfinite(args.volume) or not 0 < args.volume <= 1:
        parser.error("volume must be above 0 and no greater than 1")
    if not math.isfinite(args.duration) or args.duration <= 0:
        parser.error("duration must be above 0 seconds")
    return args


def focusrite_sinks() -> list[tuple[str, str]]:
    try:
        sinks = subprocess.run(
            ["pactl", "list", "short", "sinks"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.splitlines()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []

    matches = []
    for line in sinks:
        fields = line.split()
        if len(fields) < 2:
            continue
        index, name = fields[:2]
        if "focusrite" in name.lower() or "scarlett" in name.lower():
            matches.append((index, name))

    return matches


def active_sink_indexes(pactl_output: str) -> set[str]:
    """Return sink indexes used by uncorked playback streams."""
    active: set[str] = set()
    sink_index: str | None = None
    corked = False

    def finish_block() -> None:
        if sink_index is not None and not corked:
            active.add(sink_index)

    for line in pactl_output.splitlines():
        if line.startswith("Sink Input #"):
            finish_block()
            sink_index = None
            corked = False
            continue
        key, separator, value = line.strip().partition(":")
        if not separator:
            continue
        if key.lower() == "sink":
            sink_index = value.strip()
        elif key.lower() == "corked":
            corked = value.strip().lower() == "yes"
    finish_block()
    return active


def playing_sink_indexes() -> set[str] | None:
    """Return active sinks, or None when playback activity cannot be checked."""
    try:
        output = subprocess.run(
            ["pactl", "list", "sink-inputs"],
            check=True,
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout
    except (FileNotFoundError, subprocess.SubprocessError):
        return None
    return active_sink_indexes(output)


def pulse(frequency: float, duration: float) -> bytes:
    samples = array("h")
    frame_count = round(RATE * duration)
    fade_frames = min(round(RATE * FADE_SECONDS), frame_count // 2)
    for frame in range(frame_count):
        if frame < fade_frames:
            envelope = frame / fade_frames
        elif frame >= frame_count - fade_frames:
            envelope = (frame_count - frame - 1) / fade_frames
        else:
            envelope = 1.0
        sample = round(
            32767
            * envelope
            * math.sin(2 * math.pi * frequency * frame / RATE)
        )
        samples.extend((sample, sample))
    if sys.byteorder != "little":
        samples.byteswap()
    return samples.tobytes()


def main() -> int:
    args = arguments()
    sinks = focusrite_sinks()
    if not sinks:
        return 0

    playing = playing_sink_indexes()
    if playing is None:
        return 0

    audio = pulse(args.frequency, args.duration)
    status = 0
    try:
        for sink_index, sink_name in sinks:
            if sink_index in playing:
                continue
            result = subprocess.run(
                [
                    "pw-play",
                    "--raw",
                    "--rate",
                    str(RATE),
                    "--channels",
                    "2",
                    "--channel-map",
                    "stereo",
                    "--format",
                    "s16",
                    "--volume",
                    str(args.volume),
                    "--target",
                    sink_name,
                    "-",
                ],
                input=audio,
                check=False,
            )
            if result.returncode != 0:
                status = result.returncode
        return status
    except FileNotFoundError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
