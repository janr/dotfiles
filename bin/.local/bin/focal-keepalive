#!/usr/bin/env python3
"""Keep Focal monitors awake with a quiet ultrasonic Focusrite-only pulse."""

import argparse
from array import array
import math
import subprocess
import sys


RATE = 44_100
FADE_SECONDS = 0.2
DEFAULT_DURATION = 2.0
DEFAULT_FREQUENCY = 20_000.0
DEFAULT_VOLUME = 0.9  # Approximately -1 dBFS before downstream attenuation.
ACTIVITY_SAMPLE_SECONDS = 1.0


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Play a tone through every connected Focusrite/Scarlett output.",
    )
    parser.add_argument(
        "-f",
        "--frequency",
        type=float,
        default=DEFAULT_FREQUENCY,
        help=f"tone frequency in Hz (default: {DEFAULT_FREQUENCY:g})",
    )
    parser.add_argument(
        "-v",
        "--volume",
        type=float,
        default=DEFAULT_VOLUME,
        help=f"linear PipeWire volume from 0.0 to 1.0 (default: {DEFAULT_VOLUME:g})",
    )
    parser.add_argument(
        "-d",
        "--duration",
        type=float,
        default=DEFAULT_DURATION,
        help=f"duration in seconds (default: {DEFAULT_DURATION:g})",
    )
    args = parser.parse_args()

    if not math.isfinite(args.frequency) or not 0 < args.frequency < RATE / 2:
        parser.error(f"frequency must be above 0 and below {RATE / 2:g} Hz")
    if not math.isfinite(args.volume) or not 0 < args.volume <= 1:
        parser.error("volume must be above 0 and no greater than 1")
    if not math.isfinite(args.duration) or args.duration <= 0:
        parser.error("duration must be above 0 seconds")
    return args


def focusrite_sinks() -> list[tuple[str, str]]:
    try:
        sinks = subprocess.run(
            ["pactl", "list", "short", "sinks"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.splitlines()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []

    matches = []
    for line in sinks:
        fields = line.split()
        if len(fields) < 2:
            continue
        index, name = fields[:2]
        if "focusrite" in name.lower() or "scarlett" in name.lower():
            matches.append((index, name))

    return matches


def sink_has_audio(sink_name: str) -> bool | None:
    """Sample a sink monitor and report whether it contains a real signal."""
    try:
        result = subprocess.run(
            [
                "parec",
                "--raw",
                "--format=s16le",
                f"--rate={RATE}",
                "--channels=2",
                "--latency-msec=50",
                f"--device={sink_name}.monitor",
            ],
            check=True,
            capture_output=True,
            timeout=ACTIVITY_SAMPLE_SECONDS,
        )
        audio = result.stdout
    except subprocess.TimeoutExpired as error:
        audio = error.stdout or b""
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None

    # Conversion to signed 16-bit PCM removes insignificant floating-point
    # noise while retaining even very quiet audible output.
    audio = audio[: len(audio) - len(audio) % 2]
    samples = array("h")
    samples.frombytes(audio)
    if sys.byteorder != "little":
        samples.byteswap()
    return any(samples)


def playing_sink_indexes(sinks: list[tuple[str, str]]) -> set[str] | None:
    """Return sinks emitting audio, or None when activity cannot be checked."""
    playing: set[str] = set()
    for sink_index, sink_name in sinks:
        has_audio = sink_has_audio(sink_name)
        if has_audio is None:
            return None
        if has_audio:
            playing.add(sink_index)
    return playing


def pulse(frequency: float, duration: float) -> bytes:
    samples = array("h")
    frame_count = round(RATE * duration)
    fade_frames = min(round(RATE * FADE_SECONDS), frame_count // 2)
    for frame in range(frame_count):
        if frame < fade_frames:
            envelope = frame / fade_frames
        elif frame >= frame_count - fade_frames:
            envelope = (frame_count - frame - 1) / fade_frames
        else:
            envelope = 1.0
        sample = round(
            32767
            * envelope
            * math.sin(2 * math.pi * frequency * frame / RATE)
        )
        samples.extend((sample, sample))
    if sys.byteorder != "little":
        samples.byteswap()
    return samples.tobytes()


def main() -> int:
    args = arguments()
    sinks = focusrite_sinks()
    if not sinks:
        return 0

    playing = playing_sink_indexes(sinks)
    if playing is None:
        return 0

    audio = pulse(args.frequency, args.duration)
    status = 0
    try:
        for sink_index, sink_name in sinks:
            if sink_index in playing:
                continue
            result = subprocess.run(
                [
                    "pw-play",
                    "--raw",
                    "--rate",
                    str(RATE),
                    "--channels",
                    "2",
                    "--channel-map",
                    "stereo",
                    "--format",
                    "s16",
                    "--volume",
                    str(args.volume),
                    "--target",
                    sink_name,
                    "-",
                ],
                input=audio,
                check=False,
            )
            if result.returncode != 0:
                status = result.returncode
        return status
    except FileNotFoundError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
