#!/usr/bin/env python3
"""Toggle local Whisper dictation into the focused Wayland window."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import shutil
from pathlib import Path
import signal
import socket
import subprocess
import sys
import tempfile
import time
import wave


MODEL = Path(os.environ.get("DICTATE_MODEL", "~/.local/share/whisper/ggml-base.en.bin")).expanduser()
MAX_SECONDS = 120


def notify(summary: str, body: str = "") -> None:
    try:
        subprocess.Popen(["notify-send", "-a", "dictate", summary, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass


def active_window() -> str:
    result = subprocess.run(["hyprctl", "activewindow", "-j"],
                            capture_output=True, text=True, check=True, timeout=3)
    return str(json.loads(result.stdout).get("address", ""))


def transcribe(wav: Path, output: Path) -> str:
    subprocess.run(["whisper-cli", "-m", str(MODEL), "-f", str(wav),
                    "-nt", "-otxt", "-of", str(output)],
                   check=True, stdout=subprocess.DEVNULL, timeout=180)
    return output.with_suffix(".txt").read_text().strip()


def validate_recording(wav: Path, returncode: int, log: Path) -> None:
    """SIGINT makes some pw-record versions return 1 even for a finished WAV."""
    try:
        with wave.open(str(wav), "rb") as audio:
            if audio.getnframes() > 0:
                return
    except (OSError, EOFError, wave.Error):
        pass
    detail = log.read_text(errors="replace").strip()[-500:] if log.exists() else ""
    raise RuntimeError(
        f"Recording failed or no audio was captured (pw-record exit {returncode})"
        + (f": {detail}" if detail else "")
    )


def insert_text(text: str, *, submit: bool = False) -> None:
    """Type transcript lines without letting an embedded newline submit a prompt."""
    parts = re.split(r"\r\n|\r|\n", text)
    for index, part in enumerate(parts):
        if part:
            subprocess.run(["wtype", "--", part], check=True, timeout=30)
        if index < len(parts) - 1:
            subprocess.run(["wtype", "-M", "shift", "-k", "Return", "-m", "shift"],
                           check=True, timeout=30)
    if submit:
        subprocess.run(["wtype", "-k", "Return"], check=True, timeout=30)


def record_and_insert(server: socket.socket, *, submit: bool = False) -> None:
    window = active_window()
    if not window:
        raise RuntimeError("No focused window")
    with tempfile.TemporaryDirectory(prefix="dictate-") as directory:
        cancelled = False
        wav = Path(directory) / "speech.wav"
        log = Path(directory) / "pw-record.log"
        with log.open("wb") as errors:
            recording = subprocess.Popen(["pw-record", "--rate", "16000", "--channels", "1",
                                          "--format", "s16", str(wav)],
                                         stdout=subprocess.DEVNULL, stderr=errors)
        try:
            notify("Dictation: recording", "Release the pedal or press the shortcut again")
            server.settimeout(MAX_SECONDS)
            try:
                connection, _ = server.accept()
                with connection:
                    command = connection.recv(16)
                    if command not in (b"stop", b"cancel"):
                        raise RuntimeError("Invalid dictation command")
                    cancelled = command == b"cancel"
            except socket.timeout:
                notify("Dictation: time limit reached", "Transcribing now")
        finally:
            if recording.poll() is None:
                recording.send_signal(signal.SIGINT)  # let pw-record finalize the WAV header
                try:
                    recording.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    recording.kill()
                    recording.wait()
        if cancelled:
            return
        validate_recording(wav, recording.returncode, log)
        # No more stop requests should be accepted during inference.
        server.close()
        notify("Dictation: transcribing")
        text = transcribe(wav, Path(directory) / "speech")
        if not text:
            notify("Dictation: no speech detected")
            return
        if active_window() != window:
            notify("Dictation: not inserted", "Focus changed; transcript discarded")
            return
        # Type rather than paste: no clipboard modification or premature submission.
        insert_text(text, submit=submit)
        notify("Dictation: inserted")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", choices=("toggle", "start", "stop", "cancel"), default="toggle")
    parser.add_argument("--submit", action="store_true", help="press Enter after typing the transcript")
    args = parser.parse_args()
    action = args.action
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        print("dictate: XDG_RUNTIME_DIR is not set", file=sys.stderr)
        return 1
    path = os.path.join(runtime, "dictate.sock")
    # Keep the lock through transcription so a second session cannot steal the
    # socket, or type over a transcript that is still being inserted.
    with open(os.path.join(runtime, "dictate.lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if action == "start":
                return 0  # never stop an existing recording on pedal press
            for _ in range(10):
                try:
                    with socket.socket(socket.AF_UNIX) as client:
                        client.settimeout(1)
                        client.connect(path)
                        client.sendall(b"cancel" if action == "cancel" else b"stop")
                    return 0
                except OSError:
                    # The press process may still be binding its socket.
                    time.sleep(0.05)
            notify("Dictation: busy", "Transcribing or starting; please wait")
            return 0
        if action in ("stop", "cancel"):
            return 0  # never start recording on pedal release
        if not MODEL.is_file():
            notify("Dictation failed", f"Whisper model not found: {MODEL}")
            return 1
        for tool in ("pw-record", "whisper-cli", "wtype"):
            if not shutil.which(tool):
                notify("Dictation failed", f"Missing command: {tool}")
                return 1
        server = socket.socket(socket.AF_UNIX)
        previous_term = signal.getsignal(signal.SIGTERM)
        signal.signal(signal.SIGTERM, lambda _signum, _frame: sys.exit(1))
        try:
            # Only the lock holder may remove a stale socket.
            if os.path.exists(path):
                os.unlink(path)
            server.bind(path)
            os.chmod(path, 0o600)
            server.listen(1)
            record_and_insert(server, submit=args.submit)
        except (OSError, RuntimeError, subprocess.SubprocessError, ValueError,
                json.JSONDecodeError, KeyboardInterrupt) as error:
            print(f"dictate: {error}", file=sys.stderr)
            notify("Dictation failed", str(error))
            return 1
        finally:
            server.close()
            if os.path.exists(path):
                os.unlink(path)
            signal.signal(signal.SIGTERM, previous_term)
    return 0


if __name__ == "__main__":
    sys.exit(main())
