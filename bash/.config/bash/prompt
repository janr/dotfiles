# ~/.config/bash/prompt
# A compact Catppuccin Mocha prompt for interactive Bash.

__prompt_reset='\[\e[0m\]'
__prompt_text='\[\e[38;2;205;214;244m\]'
__prompt_subtext='\[\e[38;2;166;173;200m\]'
__prompt_blue='\[\e[38;2;137;180;250m\]'
__prompt_mauve='\[\e[38;2;203;166;247m\]'
__prompt_green='\[\e[38;2;166;227;161m\]'
__prompt_yellow='\[\e[38;2;249;226;175m\]'
__prompt_red='\[\e[38;2;243;139;168m\]'

__prompt_git() {
  command -v git >/dev/null 2>&1 || return
  command git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return

  local branch state=''
  branch=$(command git symbolic-ref --quiet --short HEAD 2>/dev/null || command git rev-parse --short HEAD 2>/dev/null) || return

  if [ -n "$(command git status --porcelain 2>/dev/null)" ]; then
    state=" ${__prompt_yellow}*${__prompt_reset}"
  fi

  printf ' %s%s %s%s%s' "$__prompt_subtext" "$__prompt_reset" "$__prompt_mauve" "$branch" "$__prompt_reset$state"
}

__prompt_venv() {
  [ -n "${VIRTUAL_ENV:-}" ] || return
  printf ' %s%s %s%s' "$__prompt_subtext" "$__prompt_reset" "$__prompt_green" "${VIRTUAL_ENV##*/}$__prompt_reset"
}

__prompt_command() {
  local exit_status=${1:-$?}
  local status=''

  if [ "$exit_status" -ne 0 ]; then
    status=" ${__prompt_red}✗ ${exit_status}${__prompt_reset}"
  fi

  PS1="\n${__prompt_blue}╭─${__prompt_text}\u${__prompt_subtext}@${__prompt_text}\h ${__prompt_blue}in ${__prompt_mauve}\w${__prompt_reset}$(__prompt_git)$(__prompt_venv)$status\n${__prompt_blue}╰─${__prompt_green}❯${__prompt_reset} "
}

PROMPT_COMMAND=__prompt_command

# Set the terminal title without cluttering the prompt itself.
case "$TERM" in
  xterm* | rxvt* | screen* | tmux* | kitty*)
    PROMPT_COMMAND='__prompt_status=$?; printf "\033]0;%s@%s: %s\007" "$USER" "${HOSTNAME%%.*}" "${PWD/#$HOME/~}"; __prompt_command "$__prompt_status"'
    ;;
esac
