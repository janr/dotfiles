def emit(text, tooltip, css_class):
    print(json.dumps({"text": text, "tooltip": tooltip, "class": css_class}))


def updated_at():
    return datetime.now().strftime("%I:%M %p").lstrip("0")


def parse_time(value):
    return datetime.strptime(value.strip(), "%I:%M %p").time()


def is_daytime(data):
    current = data["current_condition"][0]
    observed_text = current.get("localObsDateTime")
    observed = (
        datetime.strptime(observed_text, "%Y-%m-%d %I:%M %p")
        if observed_text
        else datetime.now()
    )
    astronomy = data["weather"][0]["astronomy"][0]
    sunrise = parse_time(astronomy["sunrise"])
    sunset = parse_time(astronomy["sunset"])
    return sunrise <= observed.time() < sunset


def main():
    location = os.environ.get("WAYBAR_WEATHER_LOCATION", "").strip()
    query = urllib.parse.quote(location) if location else ""
    url = f"https://wttr.in/{query}?format=j1"

    try:
        request = urllib.request.Request(url, headers={"User-Agent": "waybar-weather"})
        with urllib.request.urlopen(request, timeout=6) as response:
            data = json.load(response)
    except Exception as error:
        emit("󰖐 --", f"Weather unavailable: {error}\nUpdated {updated_at()}", "unavailable")
        return 0

    current = data["current_condition"][0]
    nearest = data.get("nearest_area", [{}])[0]
    area = nearest.get("areaName", [{}])[0].get("value", location or "Current location").strip()
    region = nearest.get("region", [{}])[0].get("value", "").strip()
    description = current["weatherDesc"][0]["value"].strip()
    code = current["weatherCode"]
    day_icon, night_icon, css_class = WEATHER_CODES.get(code, ("󰖐", "󰖐", "unknown"))
    daylight = is_daytime(data)
    icon = day_icon if daylight else night_icon

    temp = current["temp_C"]
    feels = current["FeelsLikeC"]
    humidity = current["humidity"]
    wind = current["windspeedKmph"]
    precip = current["precipMM"]

    place = f"{area}, {region}" if region else area
    text = f"{icon} {temp}°C"
    tooltip = (
        f"{place}\n"
        f"{description}, feels like {feels}°C\n"
        f"Humidity {humidity}%  Wind {wind} km/h  Precip {precip} mm\n"
        f"Sunrise {data['weather'][0]['astronomy'][0]['sunrise']}  "
        f"Sunset {data['weather'][0]['astronomy'][0]['sunset']}\n"
        f"Updated {updated_at()}"
    )
    emit(text, tooltip, f"{css_class} {'day' if daylight else 'night'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
