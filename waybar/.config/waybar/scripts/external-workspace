#!/bin/sh

id="$1"
mode="${2:-external}"

case "$id" in
  10|11|12|13|14|15|16|17|18) ;;
  *) printf '{"text":"","class":["hidden"]}\n'; exit 0 ;;
esac

label=$((id - 9))

workspaces="$(hyprctl workspaces 2>/dev/null)"
monitors="$(hyprctl monitors 2>/dev/null)"

primary_monitor="$(printf '%s\n' "$monitors" | awk '
  /^Monitor / {
    if (!first) first = $2
    if ($2 == "eDP-1") primary = $2
    monitor = $2
  }
  /focused: yes/ { focused = monitor }
  END {
    if (!primary) {
      primary = focused ? focused : first
    }
    print primary
  }
')"

has_external=false
if [ -n "$primary_monitor" ]; then
  if printf '%s\n' "$monitors" | awk -v primary="$primary_monitor" '
    /^Monitor / && $2 != primary { found = 1 }
    END { exit found ? 0 : 1 }
  '; then
    has_external=true
  fi
fi

windows="$(printf '%s\n' "$workspaces" | awk -v id="$id" '
  /^workspace ID / { current = ($3 == id) }
  current && /^[[:space:]]*windows:/ { print $2; exit }
')"

active="$(printf '%s\n' "$monitors" | awk '
  /active workspace:/ { print $3 }
')"

focused="$(printf '%s\n' "$monitors" | awk '
  /^Monitor / { monitor_active = "" }
  /active workspace:/ { monitor_active = $3 }
  /focused: yes/ { print monitor_active; exit }
')"

windows="${windows:-0}"
classes='"external"'

is_visible=false
if printf '%s\n' "$active" | awk -v id="$id" '$1 == id { found = 1 } END { exit !found }'; then
  is_visible=true
fi

if [ "$mode" = fallback ]; then
  if [ "$has_external" = true ] || { [ "$windows" -eq 0 ] 2>/dev/null && [ "$is_visible" = false ]; }; then
    printf '{"text":"","class":["external","hidden"]}\n'
    exit 0
  fi
elif [ "$has_external" != true ]; then
  printf '{"text":"","class":["external","hidden"]}\n'
  exit 0
fi

if [ "$id" -eq "$focused" ] 2>/dev/null; then
  classes="$classes,\"active\""
elif [ "$is_visible" = true ]; then
  classes="$classes,\"visible\""
fi

if [ "$windows" -gt 0 ] 2>/dev/null; then
  classes="$classes,\"occupied\""
else
  classes="$classes,\"empty\""
fi

printf '{"text":"%s","class":[%s],"tooltip":"Workspace %s"}\n' "$label" "$classes" "$id"
