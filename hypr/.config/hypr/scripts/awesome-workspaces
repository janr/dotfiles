#!/bin/sh

laptop=eDP-1

refresh_waybar_workspaces() {
    pkill -RTMIN+8 waybar >/dev/null 2>&1 || true
}

focused_monitor() {
    hyprctl monitors | awk '
        /^Monitor / { monitor = $2 }
        /focused: yes/ { print monitor; found = 1; exit }
        END { if (!found) print "" }
    '
}

primary_monitor() {
    hyprctl monitors | awk -v laptop="$laptop" '
        /^Monitor / {
            if (!first) first = $2
            if ($2 == laptop) laptop_found = $2
            monitor = $2
        }
        /focused: yes/ { focused = monitor }
        END {
            if (laptop_found) print laptop_found
            else if (focused) print focused
            else print first
        }
    '
}

external_monitor() {
    primary="$(primary_monitor)"

    hyprctl monitors | awk -v primary="$primary" '
        /^Monitor / && $2 != primary { print $2; exit }
    '
}

monitor_count() {
    hyprctl monitors | awk '
        /^Monitor / { count++ }
        END { print count + 0 }
    '
}

active_workspace_id() {
    hyprctl monitors | awk '
        /^Monitor / { active = "" }
        /active workspace:/ { active = $3 }
        /focused: yes/ { print active; exit }
    '
}

occupied_workspaces() {
    hyprctl workspaces | awk '
        /^workspace ID/ { id = $3; windows = 0 }
        /^[[:space:]]*windows:/ {
            windows = $2
            if (id >= 1 && id <= 18 && windows > 0) {
                print id
            }
        }
    ' | sort -n
}

all_workspaces() {
    i=1
    while [ "$i" -le 18 ]; do
        echo "$i"
        i=$((i + 1))
    done
}

workspace_range() {
    start="$1"
    end="$2"

    i="$start"
    while [ "$i" -le "$end" ]; do
        echo "$i"
        i=$((i + 1))
    done
}

occupied_workspace_range() {
    start="$1"
    end="$2"

    occupied_workspaces | awk -v start="$start" -v end="$end" '
        $1 >= start && $1 <= end { print $1 }
    '
}

workspace_for_key() {
    key="$1"
    monitor="$(focused_monitor)"
    primary="$(primary_monitor)"

    if [ "$(monitor_count)" -le 1 ] || [ "$monitor" = "$primary" ]; then
        echo "$key"
    else
        echo $((key + 9))
    fi
}

move_workspace_windows() {
    from="$1"
    to="$2"

    hyprctl clients | awk -v from="$from" '
        /^Window / { address = $2 }
        /workspace:/ && $2 == from { print address }
    ' | while read -r address; do
        [ -n "$address" ] && hyprctl dispatch movetoworkspacesilent "$to,address:$address" >/dev/null
    done
}

reconcile() {
    primary="$(primary_monitor)"
    external="$(external_monitor)"

    [ -z "$primary" ] && primary="$laptop"

    i=1
    while [ "$i" -le 9 ]; do
        if [ "$i" -eq 1 ]; then
            hyprctl keyword workspace "$i, monitor:$primary, persistent:true, default:true" >/dev/null
        else
            hyprctl keyword workspace "$i, monitor:$primary, persistent:true" >/dev/null
        fi
        i=$((i + 1))
    done

    i=10
    while [ "$i" -le 18 ]; do
        if [ -n "$external" ]; then
            if [ "$i" -eq 10 ]; then
                hyprctl keyword workspace "$i, monitor:$external, persistent:true, default:true" >/dev/null
            else
                hyprctl keyword workspace "$i, monitor:$external, persistent:true" >/dev/null
            fi
            hyprctl dispatch moveworkspacetomonitor "$i $external" >/dev/null 2>&1 || true
        else
            hyprctl keyword workspace "$i, monitor:$primary, persistent:true" >/dev/null
            hyprctl dispatch moveworkspacetomonitor "$i $primary" >/dev/null 2>&1 || true
        fi
        i=$((i + 1))
    done

}

merge_external_if_disconnected() {
    reconcile
}

switch_key() {
    merge_external_if_disconnected
    hyprctl dispatch workspace "$(workspace_for_key "$1")"
    refresh_waybar_workspaces
}

move_key() {
    merge_external_if_disconnected
    hyprctl dispatch movetoworkspace "$(workspace_for_key "$1")"
    refresh_waybar_workspaces
}

select_relative_workspace() {
    workspaces="$1"
    current="$(active_workspace_id)"
    direction="$2"

    [ -z "$workspaces" ] && exit 0

    case "$current" in
        ""|*[!0-9]*) current=0 ;;
    esac

    case "$direction" in
        prev)
            next="$(printf '%s\n' "$workspaces" | awk -v current="$current" '
                { if (!last) first = $1; last = $1; if ($1 < current) previous = $1 }
                END {
                    if (!previous) {
                        print last
                    } else {
                        print previous
                    }
                }
            ')"
            ;;
        next)
            next="$(printf '%s\n' "$workspaces" | awk -v current="$current" '
                { if (!first) first = $1; if ($1 > current && !candidate) candidate = $1; last = $1 }
                END {
                    if (!candidate) {
                        print first
                    } else {
                        print candidate
                    }
                }
            ')"
            ;;
        *) exit 2 ;;
    esac

    if [ -n "$next" ]; then
        hyprctl dispatch workspace "$next"
        refresh_waybar_workspaces
    fi
}

relative_workspace() {
    direction="$1"

    set -- $(relative_workspace_range)
    select_relative_workspace "$(occupied_workspace_range "$1" "$2")" "$direction"
}

all_relative_workspace() {
    select_relative_workspace "$(all_workspaces)" "$1"
}

external_relative_workspace() {
    all_relative_workspace "$1"
}

relative_workspace_range() {
    if [ "$(monitor_count)" -le 1 ]; then
        echo "1 18"
        return
    fi

    monitor="$(focused_monitor)"
    if [ "$monitor" = "$(primary_monitor)" ]; then
        echo "1 9"
    else
        echo "10 18"
    fi
}

empty_workspace_range() {
    merge_external_if_disconnected

    if [ "$(monitor_count)" -le 1 ]; then
        echo "1 18"
        return
    fi

    monitor="$(focused_monitor)"
    if [ "$monitor" = "$(primary_monitor)" ]; then
        echo "1 9"
    else
        echo "10 18"
    fi
}

empty_workspace() {
    direction="$1"

    set -- $(empty_workspace_range)
    start="$1"
    end="$2"

    occupied="$(occupied_workspaces)"

    if [ "$direction" = first ]; then
        i="$start"
        while [ "$i" -le "$end" ]; do
            if ! printf '%s\n' "$occupied" | awk -v id="$i" '$1 == id { found = 1 } END { exit found ? 0 : 1 }'; then
                echo "$i"
                return 0
            fi
            i=$((i + 1))
        done
    elif [ "$direction" = last ]; then
        i="$end"
        while [ "$i" -ge "$start" ]; do
            if ! printf '%s\n' "$occupied" | awk -v id="$i" '$1 == id { found = 1 } END { exit found ? 0 : 1 }'; then
                echo "$i"
                return 0
            fi
            i=$((i - 1))
        done
    else
        exit 2
    fi

    return 1
}

switch_empty_workspace() {
    workspace="$(empty_workspace "$1")" || exit 0

    hyprctl dispatch workspace "$workspace"
    refresh_waybar_workspaces
}

move_to_empty_workspace() {
    workspace="$(empty_workspace "$1")" || exit 0

    hyprctl dispatch movetoworkspace "$workspace"
    refresh_waybar_workspaces
}

first_empty_workspace() {
    switch_empty_workspace first
}

last_empty_workspace() {
    switch_empty_workspace last
}

move_to_first_empty_workspace() {
    move_to_empty_workspace first
}

move_to_last_empty_workspace() {
    move_to_empty_workspace last
}

watch() {
    reconcile

    if command -v socat >/dev/null 2>&1 && [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
        socket="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
        socat - UNIX-CONNECT:"$socket" | while read -r event; do
            case "$event" in
                monitoradded*|monitorremoved*)
                    reconcile
                    sleep 0.25
                    reconcile
                    sleep 1
                    reconcile
                    ;;
            esac
        done
    else
        while sleep 2; do
            reconcile
        done
    fi
}

case "$1" in
    reconcile) reconcile ;;
    watch) watch ;;
    switch) switch_key "$2" ;;
    move) move_key "$2" ;;
    prev) relative_workspace prev ;;
    next) relative_workspace next ;;
    first-empty) first_empty_workspace ;;
    last-empty) last_empty_workspace ;;
    move-first-empty) move_to_first_empty_workspace ;;
    move-last-empty) move_to_last_empty_workspace ;;
    external-prev) external_relative_workspace prev ;;
    external-next) external_relative_workspace next ;;
    *) echo "usage: $0 reconcile|watch|switch N|move N|prev|next|first-empty|last-empty|move-first-empty|move-last-empty|external-prev|external-next" >&2; exit 2 ;;
esac
