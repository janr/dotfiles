#!/bin/sh

laptop=eDP-1

refresh_waybar_workspaces() {
    pkill -RTMIN+8 waybar >/dev/null 2>&1 || true
}

update_waybar() {
    if [ -x "$HOME/.config/hypr/scripts/update-waybar" ]; then
        "$HOME/.config/hypr/scripts/update-waybar" >/dev/null 2>&1 || true
    else
        refresh_waybar_workspaces
    fi
}

focused_monitor() {
    hyprctl monitors | awk '
        /^Monitor / { monitor = $2 }
        /focused: yes/ { print monitor; found = 1; exit }
        END { if (!found) print "" }
    '
}

primary_monitor() {
    hyprctl monitors | awk -v laptop="$laptop" -v lid_is_closed="$(lid_closed && echo yes || echo no)" '
        /^Monitor / {
            if (!first) first = $2
            if ($2 == laptop) laptop_found = $2
            monitor = $2
        }
        /focused: yes/ { focused = monitor }
        END {
            if (lid_is_closed != "yes" && laptop_found) print laptop_found
            else if (first && first != laptop) print first
            else if (focused && focused != laptop) print focused
            else if (first) print first
            else print laptop_found
        }
    '
}

monitor_for_bank() {
    bank="$1"
    primary="$(primary_monitor)"

    hyprctl monitors | awk -v primary="$primary" -v bank="$bank" '
        /^Monitor / {
            if ($2 == primary) bank_for[$2] = 1
            else externals[++external_count] = $2
        }
        END {
            if (bank == 1) print primary
            else print externals[bank - 1]
        }
    '
}

external_monitor() {
    monitor_for_bank 2
}

monitor_bank() {
    monitor="$1"
    primary="$(primary_monitor)"

    hyprctl monitors | awk -v monitor="$monitor" -v primary="$primary" '
        /^Monitor / {
            if ($2 == primary) bank[$2] = 1
            else bank[$2] = ++external_count + 1
        }
        END { print bank[monitor] ? bank[monitor] : 1 }
    '
}

range_for_bank() {
    bank="$1"
    start=$((1 + (bank - 1) * 9))
    end=$((start + 8))
    echo "$start $end"
}

workspace_layout_options_for_monitor() {
    monitor="$1"

    # Portrait display: stack master/slave areas vertically instead of splitting
    # left/right, which fits the narrow rotated monitor better. Match by monitor
    # description instead of connector name because DP-* names can change.
    if hyprctl monitors -j 2>/dev/null | jq -e --arg monitor "$monitor" '
        .[] | select(
            .name == $monitor
            and (.description | test("Samsung Electric Company LU28R55|Samsung"; "i"))
        )
    ' >/dev/null 2>&1; then
        printf ', layoutopt:orientation:top'
    fi
}

monitor_count() {
    hyprctl monitors | awk '
        /^Monitor / { count++ }
        END { print count + 0 }
    '
}

lid_closed() {
    for state in /proc/acpi/button/lid/*/state; do
        [ -r "$state" ] || continue
        grep -qi 'closed' "$state" && return 0
    done

    return 1
}

external_monitor_count() {
    hyprctl monitors | awk -v laptop="$laptop" '
        /^Monitor / && $2 != laptop { count++ }
        END { print count + 0 }
    '
}

apply_lid_monitor_state() {
    # When docked with the lid closed, remove the laptop panel so the first
    # external receives workspaces 1-9. Re-enable it when the lid opens, or if
    # no external monitor remains, to avoid getting stuck with no display.
    if lid_closed && [ "$(external_monitor_count)" -gt 0 ]; then
        hyprctl keyword monitor "$laptop,disable" >/dev/null 2>&1 || true
    else
        hyprctl keyword monitor "$laptop,preferred,0x0,2" >/dev/null 2>&1 || true
    fi
}

monitor_signature() {
    hyprctl monitors | awk '
        /^Monitor / { signature = signature $2 "\n" }
        END { printf "%s", signature }
    '
}

active_workspace_id() {
    hyprctl monitors | awk '
        /^Monitor / { active = "" }
        /active workspace:/ { active = $3 }
        /focused: yes/ { print active; exit }
    '
}

active_workspace_for_monitor() {
    monitor_name="$1"

    hyprctl monitors | awk -v monitor_name="$monitor_name" '
        /^Monitor / { monitor = $2; active = "" }
        /active workspace:/ { active = $3 }
        monitor == monitor_name && /active workspace:/ { print active; exit }
    '
}

occupied_workspaces() {
    hyprctl workspaces | awk '
        /^workspace ID/ { id = $3; windows = 0 }
        /^[[:space:]]*windows:/ {
            windows = $2
            if (id >= 1 && id <= 27 && windows > 0) {
                print id
            }
        }
    ' | sort -n
}

all_workspaces() {
    i=1
    while [ "$i" -le 27 ]; do
        echo "$i"
        i=$((i + 1))
    done
}

workspace_range() {
    start="$1"
    end="$2"

    i="$start"
    while [ "$i" -le "$end" ]; do
        echo "$i"
        i=$((i + 1))
    done
}

occupied_workspace_range() {
    start="$1"
    end="$2"

    occupied_workspaces | awk -v start="$start" -v end="$end" '
        $1 >= start && $1 <= end { print $1 }
    '
}

focused_monitor_bank() {
    hyprctl monitors | awk -v laptop="$laptop" -v lid_is_closed="$(lid_closed && echo yes || echo no)" '
        /^Monitor / {
            order[++count] = $2
            if (!first) first = $2
            if ($2 == laptop) laptop_found = $2
            current = $2
        }
        /focused: yes/ { focused = current }
        END {
            if (lid_is_closed != "yes" && laptop_found) primary = laptop_found
            else {
                for (i = 1; i <= count; i++) if (order[i] != laptop) { primary = order[i]; break }
                if (!primary) primary = first
            }

            external_count = 0
            for (i = 1; i <= count; i++) {
                if (order[i] == primary) bank[order[i]] = 1
                else bank[order[i]] = ++external_count + 1
            }
            print bank[focused] ? bank[focused] : 1
        }
    '
}

workspace_for_key() {
    key="$1"
    bank="$(focused_monitor_bank)"
    echo $((key + (bank - 1) * 9))
}

move_workspace_windows() {
    from="$1"
    to="$2"

    # Use JSON here because the text output prints window addresses without the
    # 0x prefix, while Hyprland's address selector expects address:0x...
    hyprctl clients -j | jq -r --argjson from "$from" '
        .[] | select(.workspace.id == $from) | .address
    ' | while read -r address; do
        [ -n "$address" ] && hyprctl dispatch movetoworkspacesilent "$to,address:$address" >/dev/null
    done
}

swap_current_bank_with_main() {
    current_bank="$(focused_monitor_bank)"

    # The main display already owns workspaces 1-9. Only do the swap when an
    # external/non-main display is focused.
    [ "$current_bank" -eq 1 ] && exit 0

    main_monitor="$(monitor_for_bank 1)"
    current_monitor="$(monitor_for_bank "$current_bank")"
    [ -n "$main_monitor" ] && [ -n "$current_monitor" ] || exit 0

    main_ws="$(active_workspace_for_monitor "$main_monitor")"
    current_ws="$(active_workspace_for_monitor "$current_monitor")"

    case "$main_ws:$current_ws" in
        *[!0-9:]*|:*) exit 0 ;;
    esac

    # Only swap the two visible workspaces. This avoids the disorienting flash
    # from moving all 9 workspaces and then changing each monitor's selection.
    scratch_ws=28
    move_workspace_windows "$main_ws" "$scratch_ws"
    move_workspace_windows "$current_ws" "$main_ws"
    move_workspace_windows "$scratch_ws" "$current_ws"

    reconcile
    update_waybar
}

reconcile() {
    apply_lid_monitor_state

    primary="$(primary_monitor)"

    [ -z "$primary" ] && primary="$laptop"

    bank=1
    while [ "$bank" -le 3 ]; do
        monitor="$(monitor_for_bank "$bank")"

        set -- $(range_for_bank "$bank")
        start="$1"
        end="$2"

        i="$start"
        while [ "$i" -le "$end" ]; do
            if [ -n "$monitor" ]; then
                layout_options="$(workspace_layout_options_for_monitor "$monitor")"
                if [ "$i" -eq "$start" ]; then
                    hyprctl keyword workspace "$i, monitor:$monitor, persistent:true, default:true$layout_options" >/dev/null
                else
                    hyprctl keyword workspace "$i, monitor:$monitor, persistent:true$layout_options" >/dev/null
                fi
                hyprctl dispatch moveworkspacetomonitor "$i $monitor" >/dev/null 2>&1 || true
            else
                # No physical display owns this bank right now. Do not keep
                # empty persistent workspaces alive on another monitor; Hyprland
                # may still show occupied orphaned workspaces until their
                # windows are moved away, which is what we want.
                hyprctl keyword workspace "$i, persistent:false" >/dev/null 2>&1 || true
            fi
            i=$((i + 1))
        done

        bank=$((bank + 1))
    done
}

activate_external_default_workspace() {
    external="$(external_monitor)"
    [ -n "$external" ] || return 0

    focused="$(focused_monitor)"

    hyprctl dispatch focusmonitor "$external" >/dev/null 2>&1 || return 0
    hyprctl dispatch workspace 10 >/dev/null 2>&1 || true

    if [ -n "$focused" ] && [ "$focused" != "$external" ]; then
        hyprctl dispatch focusmonitor "$focused" >/dev/null 2>&1 || true
    fi
}

switch_key() {
    hyprctl dispatch workspace "$(workspace_for_key "$1")"
    refresh_waybar_workspaces
}

move_key() {
    hyprctl dispatch movetoworkspace "$(workspace_for_key "$1")"
    refresh_waybar_workspaces
}

select_relative_workspace() {
    workspaces="$1"
    current="$(active_workspace_id)"
    direction="$2"

    [ -z "$workspaces" ] && exit 0

    case "$current" in
        ""|*[!0-9]*) current=0 ;;
    esac

    case "$direction" in
        prev)
            next="$(printf '%s\n' "$workspaces" | awk -v current="$current" '
                { if (!last) first = $1; last = $1; if ($1 < current) previous = $1 }
                END {
                    if (!previous) {
                        print last
                    } else {
                        print previous
                    }
                }
            ')"
            ;;
        next)
            next="$(printf '%s\n' "$workspaces" | awk -v current="$current" '
                { if (!first) first = $1; if ($1 > current && !candidate) candidate = $1; last = $1 }
                END {
                    if (!candidate) {
                        print first
                    } else {
                        print candidate
                    }
                }
            ')"
            ;;
        *) exit 2 ;;
    esac

    if [ -n "$next" ]; then
        hyprctl dispatch workspace "$next"
        refresh_waybar_workspaces
    fi
}

relative_workspace() {
    direction="$1"

    set -- $(relative_workspace_range)
    select_relative_workspace "$(workspace_range "$1" "$2")" "$direction"
}

all_relative_workspace() {
    select_relative_workspace "$(all_workspaces)" "$1"
}

external_relative_workspace() {
    direction="$1"

    set -- $(relative_workspace_range)
    select_relative_workspace "$(workspace_range "$1" "$2")" "$direction"
}

relative_workspace_range() {
    if [ "$(monitor_count)" -le 1 ]; then
        echo "1 27"
        return
    fi

    range_for_bank "$(focused_monitor_bank)"
}

empty_workspace_range() {
    range_for_bank "$(focused_monitor_bank)"
}

empty_workspace() {
    direction="$1"

    set -- $(empty_workspace_range)
    start="$1"
    end="$2"

    occupied="$(occupied_workspaces)"

    if [ "$direction" = first ]; then
        i="$start"
        while [ "$i" -le "$end" ]; do
            if ! printf '%s\n' "$occupied" | awk -v id="$i" '$1 == id { found = 1 } END { exit found ? 0 : 1 }'; then
                echo "$i"
                return 0
            fi
            i=$((i + 1))
        done
    elif [ "$direction" = last ]; then
        i="$end"
        while [ "$i" -ge "$start" ]; do
            if ! printf '%s\n' "$occupied" | awk -v id="$i" '$1 == id { found = 1 } END { exit found ? 0 : 1 }'; then
                echo "$i"
                return 0
            fi
            i=$((i - 1))
        done
    else
        exit 2
    fi

    return 1
}

switch_empty_workspace() {
    workspace="$(empty_workspace "$1")" || exit 0

    hyprctl dispatch workspace "$workspace"
    refresh_waybar_workspaces
}

move_to_empty_workspace() {
    workspace="$(empty_workspace "$1")" || exit 0

    hyprctl dispatch movetoworkspace "$workspace"
    refresh_waybar_workspaces
}

first_empty_workspace() {
    switch_empty_workspace first
}

last_empty_workspace() {
    switch_empty_workspace last
}

move_to_first_empty_workspace() {
    move_to_empty_workspace first
}

move_to_last_empty_workspace() {
    move_to_empty_workspace last
}

watch() {
    reconcile
    update_waybar

    previous_monitors="$(monitor_signature)"
    previous_lid="$(lid_closed && echo closed || echo open)"

    while sleep 1; do
        current_monitors="$(monitor_signature)"
        current_lid="$(lid_closed && echo closed || echo open)"

        if [ "$current_monitors" != "$previous_monitors" ] || [ "$current_lid" != "$previous_lid" ]; then
            sleep 0.25
            reconcile
            sleep 0.75
            reconcile
            activate_external_default_workspace
            update_waybar
            previous_monitors="$(monitor_signature)"
            previous_lid="$(lid_closed && echo closed || echo open)"
        fi
    done
}

restart_watch() {
    pgrep -f "$HOME/.config/hypr/scripts/awesome-workspaces watch" 2>/dev/null | while read -r pid; do
        [ "$pid" = "$$" ] && continue
        kill "$pid" >/dev/null 2>&1 || true
    done

    "$HOME/.config/hypr/scripts/awesome-workspaces" watch &
}

case "$1" in
    reconcile) reconcile ;;
    update-waybar) update_waybar ;;
    watch) watch ;;
    restart-watch) restart_watch ;;
    switch) switch_key "$2" ;;
    move) move_key "$2" ;;
    prev) relative_workspace prev ;;
    next) relative_workspace next ;;
    first-empty) first_empty_workspace ;;
    last-empty) last_empty_workspace ;;
    move-first-empty) move_to_first_empty_workspace ;;
    move-last-empty) move_to_last_empty_workspace ;;
    swap-main) swap_current_bank_with_main ;;
    external-prev) external_relative_workspace prev ;;
    external-next) external_relative_workspace next ;;
    *) echo "usage: $0 reconcile|watch|restart-watch|switch N|move N|prev|next|first-empty|last-empty|move-first-empty|move-last-empty|swap-main|external-prev|external-next" >&2; exit 2 ;;
esac
