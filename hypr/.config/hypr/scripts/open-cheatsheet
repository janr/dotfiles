#!/bin/sh

# Open local cheatsheets on the main Acer display and leave focus there so the
# popup can be closed from the keyboard.

case "$1" in
    hyprland) file="$HOME/.local/share/cheatsheets/hyprland.html" ;;
    nvim) file="$HOME/.local/share/cheatsheets/nvim.html" ;;
    pi) file="$HOME/.local/share/cheatsheets/pi.html" ;;
    *) echo "usage: $0 hyprland|nvim|pi" >&2; exit 2 ;;
esac

main_monitor() {
    hyprctl monitors -j | jq -r '
        (.[] | select(.description | test("Acer Technologies Acer RT280K|Acer"; "i")) | .name),
        (.[0].name)
    ' | head -n 1
}

main="$(main_monitor)"

if [ -n "$main" ] && [ "$main" != "null" ]; then
    if [ "${HYPR_WORKSPACE_API:-legacy}" = lua ]; then
        hyprctl dispatch "hl.dsp.focus({ monitor = \"$main\" })" >/dev/null 2>&1 || true
    else
        hyprctl dispatch focusmonitor "$main" >/dev/null 2>&1 || true
    fi
fi

if command -v zen-browser >/dev/null 2>&1; then
    browser=zen-browser
elif command -v zen >/dev/null 2>&1; then
    browser=zen
elif command -v google-chrome >/dev/null 2>&1; then
    browser=google-chrome
else
    echo "No supported browser found (tried zen-browser, zen, and google-chrome)." >&2
    exit 1
fi

"$browser" --new-window "file://$file" >/dev/null 2>&1 &
