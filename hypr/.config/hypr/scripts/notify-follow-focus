#!/usr/bin/env python3
import json
import os
import re
import socket
import subprocess
import time
from pathlib import Path

CONFIG = Path.home() / ".config/noctalia/config.toml"
MONITORS_LINE = re.compile(r"^(\s*)monitors\s*=.*$")


def socket2_path():
    runtime_dir = os.environ["XDG_RUNTIME_DIR"]
    sig = os.environ["HYPRLAND_INSTANCE_SIGNATURE"]
    return Path(runtime_dir) / "hypr" / sig / ".socket2.sock"


def focused_monitor():
    try:
        out = subprocess.check_output(["hyprctl", "monitors", "-j"], text=True, timeout=2)
        mons = json.loads(out)
    except (subprocess.SubprocessError, ValueError, OSError):
        return None
    for mon in mons:
        if mon.get("focused"):
            return mon.get("name")
    return None


def set_notification_monitor(name):
    lines = CONFIG.read_text().splitlines(keepends=True)
    value = f'[ "{name}" ]' if name else "[]"
    section = None
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]") and not stripped.startswith("[["):
            section = stripped
            continue
        if section == "[notification]":
            match = MONITORS_LINE.match(line)
            if match:
                new_line = f"{match.group(1)}monitors = {value}\n"
                if new_line == line:
                    return False
                lines[i] = new_line
                CONFIG.write_text("".join(lines))
                return True
    return False


def reload_noctalia():
    subprocess.run(
        ["noctalia", "msg", "config-reload"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    last = object()

    def apply(monitor):
        nonlocal last
        if not monitor or monitor == last:
            return
        last = monitor
        if set_notification_monitor(monitor):
            reload_noctalia()

    apply(focused_monitor())

    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(str(socket2_path()))
                buf = b""
                while True:
                    chunk = sock.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        text = line.decode(errors="ignore")
                        if text.startswith("focusedmon>>"):
                            payload = text.split(">>", 1)[1]
                            apply(payload.split(",", 1)[0])
        except OSError:
            pass
        time.sleep(2)


if __name__ == "__main__":
    main()
